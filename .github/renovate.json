{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rainbowdashlabs/rainbowdashlabs",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "baseBranchPatterns": ["main"],
  "schedule": ["on friday"],
  "packageRules": [
    {
      "groupName": "jjwt",
      "matchPackageNames": [
        "/^io\\.jsonwebtoken/"
      ]
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
